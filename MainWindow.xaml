<Window x:Class="GlassTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassTerminal"
        Width="900"
        Height="560"
        MinWidth="520"
        MinHeight="320"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#FF0B1724"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">
    <Grid Background="#FF0B1724">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF142536"
                BorderBrush="#FF34495D"
                BorderThickness="0,0,0,1">
            <TabControl Background="Transparent"
                        BorderThickness="0"
                        Padding="8,3,0,0"
                        FontFamily="Segoe UI"
                        FontSize="12">
                <TabItem Header="CMD"
                         Padding="16,3"
                         Foreground="#FFF0F5F9"
                         Background="#FF0B1724"
                         BorderBrush="#FF34495D" />
            </TabControl>
        </Border>

        <Border Grid.Row="1"
                Margin="0"
                Background="#FF0B1724">
            <Grid Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="TerminalOutput"
                         Grid.Row="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFF0F5F9"
                         CaretBrush="#FFFFC078"
                         SelectionBrush="#667CA9C8"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         IsReadOnly="True"
                         IsTabStop="False"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextChanged="TerminalOutput_TextChanged" />

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="›"
                               Foreground="#FFFFC078"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="2,0,9,2" />
                    <TextBox x:Name="CommandInput"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFF0F5F9"
                             CaretBrush="#FFFFC078"
                             FontFamily="Segoe UI"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Padding="0"
                             KeyDown="CommandInput_KeyDown" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
