<Window x:Class="GlassTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassTerminal"
        Width="900"
        Height="560"
        MinWidth="520"
        MinHeight="320"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">
    <Grid x:Name="WindowRoot" Background="Transparent">
        <TextBox x:Name="TerminalOutput"
                 Margin="14,10,14,12"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#FFF0F5F9"
                 CaretBrush="#FFFFC078"
                 SelectionBrush="#667CA9C8"
                 FontFamily="Microsoft YaHei"
                 FontSize="14"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Hidden"
                 HorizontalScrollBarVisibility="Hidden"
                 TextChanged="TerminalOutput_TextChanged"
                 PreviewKeyDown="TerminalOutput_PreviewKeyDown"
                 PreviewTextInput="TerminalOutput_PreviewTextInput"
                 PreviewMouseDown="TerminalOutput_PreviewMouseDown"
                 PreviewMouseUp="TerminalOutput_PreviewMouseUp" />
    </Grid>
</Window>
